{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "format:check": { "outputs": [] },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "test": { "outputs": ["coverage/**"] },
    "clean": { "cache": false }
  }
}
