{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": { "cache": false, "persistent": true, "dependsOn": ["^build"] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"],
      "outputs": []
    },
    "test": { "outputs": ["coverage/**"] },
    "clean": { "cache": false }
  }
}
