{
  "name": "@starter/api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "exports": {
    ".": {
      "development": "./src/app.ts",
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsup src/index.ts src/app.ts src/rpc.ts --format esm --dts --out-dir dist --clean",
    "check": "pnpm check-types && pnpm lint && pnpm format:check",
    "check-types": "tsc --noEmit",
    "dev": "dotenv -e .env.development -- tsx watch src/index.ts",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "test": "vitest run --config vitest.config.ts",
    "auth:generate": "dotenv -e .env.development -- better-auth generate --config src/modules/auth/auth.ts --output src/modules/auth/auth.generated.ts --yes",
    "auth:bootstrap-admin": "dotenv -e .env.development -- tsx src/scripts/bootstrap-admin.ts",
    "ai:auth": "dotenv -e .env.development -- tsx src/scripts/ai-auth.ts",
    "ai:provider-smoke": "dotenv -e .env.development -- tsx src/scripts/ai-provider-smoke.ts",
    "db:generate": "dotenv -e .env.development -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.development -- drizzle-kit migrate",
    "db:check": "dotenv -e .env.development -- drizzle-kit check",
    "db:studio": "dotenv -e .env.development -- drizzle-kit studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-session-backend-sqlite-node": "catalog:",
    "@earendil-works/pi-telemetry": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@starter/contracts": "workspace:*",
    "better-auth": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "eventsource-parser": "catalog:",
    "hono": "catalog:",
    "nodemailer": "catalog:",
    "pino": "catalog:",
    "pino-roll": "catalog:",
    "uuidv7": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "catalog:",
    "@starter/eslint-config": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
