# 基础环境
# 让 Node 以 development 条件解析 @starter/api（指向 src 源码而非 dist 构建产物）。由脚本里的 dotenv 读取，不要改成 shell 内联 NODE_OPTIONS=... 写法，Windows 不支持。
NODE_OPTIONS=--conditions=development
APP_ENV=development
APP_INSTANCE_ID=local
APP_RELEASE=dev
LOG_LEVEL=debug
# LOGS_DIR=./data/logs
PORT=7788

# 数据与文件存储
DATABASE_PATH=./data/app.db
AGENT_SESSION_DATABASE_PATH=./data/agent-sessions.db
FILES_DIR=./data/files
# AI 图片附件存储目录，与通用文件存储分离
AI_ATTACHMENTS_DIR=./data/ai-attachments

# AI Provider 凭据使用 AES-256-GCM 加密。值为 32 字节随机密钥的 base64 编码。
# 生成命令：openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEY=
# 单次模型请求超时，范围 1000 到 3600000 毫秒
AI_REQUEST_TIMEOUT_MS=60000
# Agent Run 总时长上限，毫秒，范围 1000 到 3600000；多轮长任务需调大
AI_RUN_MAX_MS=120000
# 生产环境允许访问的私网 CIDR，多个值用逗号分隔；开发/测试环境的 localhost 不需要填写
AI_PRIVATE_CIDR_ALLOWLIST=
# 测试用 AI 工具（仅开发/测试环境开启；生产不要配置）
AI_TEST_TOOLS_ENABLED=true

# AI Run Webhook 终态推送（默认关闭；开启后 Run 终态会周期扫描并 POST 推送到已配置端点）
AI_WEBHOOK_ENABLED=false
# 投递器扫描间隔，毫秒，最小 1000
AI_WEBHOOK_SWEEP_INTERVAL_MS=5000
# 单次 Webhook 请求超时，毫秒，最小 1000
AI_WEBHOOK_TIMEOUT_MS=10000
# 最大投递尝试次数，1-10
AI_WEBHOOK_MAX_ATTEMPTS=5
# 重试退避间隔，毫秒，逗号分隔；次数超出后重复末位
AI_WEBHOOK_BACKOFF_MS=0,30000,120000,600000,1800000

# Better Auth 认证（BETTER_AUTH_SECRET 必填，至少 32 字符，上线前换成随机值）
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-secret
BETTER_AUTH_URL=http://localhost:7788
# 第三方前端 origin 需要追加到此处，多个用逗号分隔
CORS_ORIGINS=http://localhost:2333,http://localhost:4399

# 第三方 OAuth 登录（client id 与 secret 必须成对填写；留空时前端不显示对应登录按钮）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# bootstrap-admin 脚本用：把该邮箱账号的角色替换为 admin（账号需已存在）
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# 邮件发送：不配置 SMTP_HOST 时邮件打印到日志（本地开发用）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 邮件内链接指向的 Admin 前端地址
ADMIN_BASE_URL=http://localhost:2333

# 是否挂载 OpenAPI 文档（/doc）
OPENAPI_ENABLED=true
