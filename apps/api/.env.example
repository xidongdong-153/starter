# 基础环境
APP_ENV=development
APP_INSTANCE_ID=local
APP_RELEASE=dev
LOG_LEVEL=debug
# LOGS_DIR=./data/logs
PORT=7788

# 数据与文件存储
DATABASE_PATH=./data/app.db
FILES_DIR=./data/files

# Better Auth 认证（BETTER_AUTH_SECRET 必填，至少 32 字符，上线前换成随机值）
BETTER_AUTH_SECRET=replace-with-at-least-32-characters-secret
BETTER_AUTH_URL=http://localhost:7788
CORS_ORIGINS=http://localhost:2333,http://localhost:4399

# 第三方 OAuth 登录（client id 与 secret 必须成对填写；留空时前端不显示对应登录按钮）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# bootstrap-admin 脚本用：把该邮箱账号的角色替换为 admin（账号需已存在）
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# 邮件发送：不配置 SMTP_HOST 时邮件打印到日志（本地开发用）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 邮件内链接指向的 Admin 前端地址
ADMIN_BASE_URL=http://localhost:2333

# 是否挂载 OpenAPI 文档（/doc）
OPENAPI_ENABLED=true
